import streamlit as st
import random
import time

# CSS koji u potpunosti sakriva Streamlitovu bočnu traku (sidebar), menije i zaglavlja
st.markdown("""
    <style>
    [data-testid="stSidebar"] {display: none !important;}
    [data-testid="collapsedControl"] {display: none !important;}
    #MainMenu {visibility: hidden !important;}
    footer {visibility: hidden !important;}
    header {visibility: hidden !important;}
    .stApp {
        background-color: #131314;
        color: #e3e3e3;
        font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .stChatMessage {
        background-color: #1e1f20;
        border-radius: 16px;
        padding: 14px;
        margin-bottom: 12px;
        border: 1px solid #333538;
    }
    </style>
""", unsafe_allow_html=True)

st.markdown("## 🧠 Hashim")
st.caption("Tvoj lični AI sportski analitičar.")

# Inicijalizacija chata
if "messages" not in st.session_state:
    st.session_state.messages = [
        {"role": "assistant", "content": "Zdravo Merzuhe! Ja sam Hashim. Pošalji mi parove koje želiš da analiziramo (možeš ubaciti i više njih odjednom, svaki u novi red), izaberi sport ispod i pokrenut ću simulaciju."}
    ]

# Prikaz istorije poruka u oblačićima
for message in st.session_state.messages:
    with st.chat_message(message["role"]):
        st.markdown(message["content"])

# Odabir sporta (sada preko običnih radio dugmadi direktno u chatu, bez bočne trake)
sport_izbor = st.radio("Izaberi sport:", ["Fudbal ⚽", "Košarka 🏀"], horizontal=True, label_visibility="collapsed")

# Donje polje za unos poruke (podržava više redova za više parova odjednom)
if prompt := st.chat_input("Unesi parove (npr. Real - Barca, Inter - Milan)..."):
    st.session_state.messages.append({"role": "user", "content": prompt})
    with st.chat_message("user"):
        st.markdown(prompt)

    with st.chat_message("assistant"):
        with st.spinner("Hashim analizira parove i vrši simulacije..."):
            time.sleep(1.2)
            
        # Razdvajanje parova po novim redovima ili zarezima
        parovi_lista = [p.strip() for p in prompt.replace("\n", ",").split(",") if p.strip()]
        
        odgovor = f"Evo rezultata masovne simulacije za tvoj tiket:\n\n"
        
        for i, par in enumerate(parovi_lista, 1):
            p_dom = random.randint(43, 59)
            p_gost = random.randint(21, 37)
            p_ner = 100 - (p_dom + p_gost)
            
            if "Fudbal" in sport_izbor:
                sansa_golova = random.randint(62, 86)
                odgovor += f"**{i}. {par}**\n* 1: {p_dom}% | X: {p_ner}% | 2: {p_gost}%\n* 🔥 Over 2.5 gola: **{sansa_golova}%**\n\n"
            else:
                adj_dom = p_dom + (p_ner / 2)
                adj_gost = p_gost + (p_ner / 2)
                margina = random.randint(154, 220)
                odgovor += f"**{i}. {par}**\n* Pobjeda domaćina: {adj_dom:.1f}% | Pobjeda gosta: {adj_gost:.1f}%\n* 🔥 Margina koševa: **~{margina}**\n\n"
                
        odgovor += "Slobodno pošalji novi tiket!"
        
        st.markdown(odgovor)
        st.session_state.messages.append({"role": "assistant", "content": odgovor})
